<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Game Night Crew - Server Portal</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      scroll-behavior: smooth;
    }

    body {
      background-color: #0d0914;
      color: #f8fafc;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* --- Navigation --- */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      background: rgba(13, 9, 20, 0.9);
      backdrop-filter: blur(10px);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 2rem;
      z-index: 1000;
      border-bottom: 1px solid #2a1b3d;
    }

    nav .logo {
      font-weight: bold;
      color: #a855f7;
      font-size: 1.2rem;
    }

    nav ul {
      display: flex;
      list-style: none;
      gap: 1.5rem;
    }

    nav ul li a {
      color: #94a3b8;
      text-decoration: none;
      font-weight: 500;
      transition: color 0.3s;
    }

    nav ul li a:hover {
      color: #a855f7;
    }

    /* --- Hero Section --- */
    .hero {
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 0 1rem;
    }

    .fly-in-title {
      font-size: 3.5rem;
      font-weight: 800;
      color: #c084fc;
      text-shadow: 0 0 20px rgba(168, 85, 247, 0.4);
      opacity: 0;
      transform: translateY(-50px);
      animation: flyIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      margin-bottom: 1rem;
    }

    .fly-in-subtitle {
      font-size: 1.2rem;
      color: #94a3b8;
      opacity: 0;
      transform: translateY(30px);
      animation: flyIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
      margin-bottom: 2rem;
    }

    .scroll-down-btn {
      background: #a855f7;
      color: #ffffff;
      padding: 0.8rem 1.8rem;
      border-radius: 30px;
      text-decoration: none;
      font-weight: bold;
      opacity: 0;
      animation: fadeIn 1s ease 0.8s forwards;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .scroll-down-btn:hover {
      transform: scale(1.05);
      box-shadow: 0 0 15px rgba(168, 85, 247, 0.6);
    }

    @keyframes flyIn {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeIn {
      to {
        opacity: 1;
      }
    }

    /* --- Sections General --- */
    section {
      padding: 6rem 2rem 4rem 2rem;
      max-width: 1000px;
      margin: 0 auto;
    }

    h2 {
      font-size: 2rem;
      margin-bottom: 1.5rem;
      color: #f8fafc;
      border-left: 4px solid #a855f7;
      padding-left: 10px;
    }

    /* --- Events Section --- */
    .events-container {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .event-card {
      background: #181024;
      border: 1px solid #2a1b3d;
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    }

    .event-info h3 {
      font-size: 1.3rem;
      color: #f8fafc;
      margin-bottom: 0.4rem;
    }

    .event-info p {
      color: #94a3b8;
      font-size: 0.95rem;
      margin-bottom: 0.8rem;
    }

    .event-time {
      font-size: 0.85rem;
      color: #c084fc;
      font-weight: bold;
    }

    .badge-november {
      background-color: #7e22ce;
      color: white;
      padding: 0.3rem 0.8rem;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: bold;
      display: inline-block;
      margin-bottom: 0.5rem;
    }

    /* --- Server Stats Grid --- */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
    }

    .card {
      background-color: #181024;
      border: 1px solid #2a1b3d;
      border-radius: 12px;
      padding: 1.5rem;
    }

    .card h3 {
      font-size: 1rem;
      color: #94a3b8;
      margin-bottom: 0.8rem;
    }

    .card .value {
      font-size: 2rem;
      font-weight: bold;
      color: #f8fafc;
    }

    .progress-bar {
      width: 100%;
      height: 8px;
      background-color: #2a1b3d;
      border-radius: 4px;
      overflow: hidden;
      margin-top: 0.5rem;
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background-color: #a855f7;
      transition: width 0.4s ease;
    }

    /* --- Content Boxes --- */
    .content-box {
      background: #181024;
      border: 1px solid #2a1b3d;
      border-radius: 12px;
      padding: 2rem;
      line-height: 1.7;
      color: #cbd5e1;
    }

    .rules-list {
      list-style-type: none;
      counter-reset: rule-counter;
    }

    .rules-list li {
      counter-increment: rule-counter;
      margin-bottom: 1rem;
      display: flex;
      align-items: flex-start;
      gap: 1rem;
    }

    .rules-list li::before {
      content: "0" counter(rule-counter);
      color: #a855f7;
      font-weight: bold;
    }

    .btn {
      background: #2a1b3d;
      color: white;
      padding: 0.8rem 1.5rem;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 500;
      display: inline-block;
      transition: background 0.2s;
    }

    .btn:hover {
      background: #a855f7;
      color: white;
    }

    footer {
      text-align: center;
      padding: 2rem;
      color: #64748b;
      border-top: 1px solid #2a1b3d;
      margin-top: 4rem;
    }
  </style>
</head>
<body>

  <!-- Navigation -->
  <nav>
    <div class="logo">Game Night Crew</div>
    <ul>
      <li><a href="#home">Home</a></li>
      <li><a href="#events">Events</a></li>
      <li><a href="#stats">Server-Status</a></li>
      <li><a href="#rules">Regeln</a></li>
      <li><a href="#story">Unsere Story</a></li>
      <li><a href="#links">Links</a></li>
    </ul>
  </nav>

  <!-- Hero Startseite -->
  <div id="home" class="hero">
    <h1 id="server-main-title" class="fly-in-title">Game Night Crew</h1>
    <p class="fly-in-subtitle">Der Ort zum Zocken, Wohlfühlen und Spaß haben.</p>
    <a href="#events" class="scroll-down-btn">Entdecke die Events ↓</a>
  </div>

  <!-- Events Sektion -->
  <section id="events">
    <h2>🚀 Neue Events im November</h2>
    <div class="events-container">
      
      <div class="event-card">
        <div class="event-info">
          <span class="badge-november">NOVEMBER HIGHLIGHT</span>
          <h3>Among Us & Phasmophobia Nächte</h3>
          <p>Gemeinsam Beweise sammeln, Geister jagen oder den Impostor entlarven – packt eure Freunde ein!</p>
          <div class="event-time">🗓️ Jeden Freitag & Samstag Abend</div>
        </div>
        <div>
          <a href="https://discord.gg/JRznXkNNG" target="_blank" class="btn">Discord Beitreten</a>
        </div>
      </div>

      <div class="event-card">
        <div class="event-info">
          <span class="badge-november">NOVEMBER HIGHLIGHT</span>
          <h3>Apex Legends Squads</h3>
          <p>Zeigt euer Können im Team, kämpft euch an die Spitze und gewinnt exklusive Rollen auf dem Server.</p>
          <div class="event-time">🗓️ Geplante Turniere im November</div>
        </div>
        <div>
          <a href="https://discord.gg/JRznXkNNG" target="_blank" class="btn">Mitmachen</a>
        </div>
      </div>

    </div>
  </section>

  <!-- Server Live Status -->
  <section id="stats">
    <h2>Server Live-Status</h2>
    <div class="grid">
      <div class="card">
        <h3>CPU Auslastung</h3>
        <div class="value" id="cpu-val">0%</div>
        <div class="progress-bar"><div class="progress-fill" id="cpu-bar"></div></div>
      </div>

      <div class="card">
        <h3>Arbeitsspeicher (RAM)</h3>
        <div class="value" id="ram-val">0%</div>
        <div class="progress-bar"><div class="progress-fill" id="ram-bar"></div></div>
      </div>

      <div class="card">
        <h3>Festplatte</h3>
        <div class="value" id="disk-val">0%</div>
        <div class="progress-bar"><div class="progress-fill" id="disk-bar"></div></div>
      </div>
    </div>
  </section>

  <!-- Regeln -->
  <section id="rules">
    <h2>Server-Regeln</h2>
    <div class="content-box">
      <ul class="rules-list">
        <li><strong>Respektvoller Umgang:</strong> Behandle alle Mitglieder auf Augenhöhe und halte die Atmosphäre freundlich.</li>
        <li><strong>Kein Spam:</strong> Keine unaufgeforderte Werbung oder Spam in den Text- und Voicekanälen.</li>
        <li><strong>Keine sensiblen Daten:</strong> Schütze deine Privatsphäre und teile keine persönlichen Daten.</li>
        <li><strong>Spaß haben:</strong> Der wichtigste Punkt – genießt die gemeinsame Zeit beim Zocken!</li>
      </ul>
    </div>
  </section>

  <!-- Unsere Story Sektion -->
  <section id="story">
    <h2>📖 Warum wir Game Night Crew erschaffen haben</h2>
    <div class="content-box">
      <p>
        Alles begann am <strong>15. Mai</strong>. Wir hatten schon lange den Wunsch nach einem ganz eigenen Server – einem Ort, an dem wir uns alle gemeinsam hinsetzen und einen Raum für Spiele schaffen konnten, in dem sich wirklich <strong>jeder wohlfühlt</strong>. 
      </p>
      <p style="margin-top: 1rem;">
        Aus diesem Gedanken heraus ist die <em>Game Night Crew</em> entstanden. Keine toxische Atmosphäre, sondern purer Gaming-Spaß, tolle Gespräche und Community-Aktionen, die zusammenschweißen.
      </p>
    </div>
  </section>

  <!-- Links -->
  <section id="links">
    <h2>Wichtige Links & Social Media</h2>
    <div class="content-box">
      <p style="margin-bottom: 1rem; color: #94a3b8;">Folge uns auf unseren Kanälen:</p>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <a href="https://tiktok.com" target="_blank" class="btn">🎵 TikTok</a>
        <a href="https://discord.gg/JRznXkNNG" target="_blank" class="btn">💬 Discord Server</a>
      </div>
    </div>
  </section>

  <footer>
    <p>&copy; 2026 Game Night Crew. Alle Rechte vorbehalten.</p>
  </footer>

  <script>
    function getBarColor(percent) {
      if (percent > 85) return '#ef4444';
      if (percent > 65) return '#f59e0b';
      return '#a855f7';
    }

    async function fetchStats() {
      try {
        const response = await fetch('/api/stats');
        const data = await response.json();

        document.getElementById('cpu-val').innerText = data.cpu_percent + '%';
        const cpuBar = document.getElementById('cpu-bar');
        cpuBar.style.width = data.cpu_percent + '%';
        cpuBar.style.backgroundColor = getBarColor(data.cpu_percent);

        document.getElementById('ram-val').innerText = data.ram_percent + '%';
        const ramBar = document.getElementById('ram-bar');
        ramBar.style.width = data.ram_percent + '%';
        ramBar.style.backgroundColor = getBarColor(data.ram_percent);

        document.getElementById('disk-val').innerText = data.disk_percent + '%';
        const diskBar = document.getElementById('disk-bar');
        diskBar.style.width = data.disk_percent + '%';
        diskBar.style.backgroundColor = getBarColor(data.disk_percent);

      } catch (err) {
        console.error('Fehler beim Abrufen der Daten:', err);
      }
    }

    setInterval(fetchStats, 2000);
    fetchStats();
  </script>

</body>
</html>